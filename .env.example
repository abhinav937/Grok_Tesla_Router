# xAI Grok API key (server-only, never expose to client)
XAI_API_KEY=xai-...

# Google Maps JavaScript API key (browser-visible — restrict to your domain + Maps JS API + Places API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...

# Google Maps server API key (server-only — restrict to Directions API only)
GOOGLE_MAPS_SERVER_API_KEY=AIza...

# Google Maps Map ID (REQUIRED for Advanced Markers + modern vector map styling)
# Create at: Google Cloud Console → Maps Platform → Map IDs → Create Map ID
# (Optional: also create a custom Map Style in Cloud-based styling for a "Tesla Dark" look and associate it)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your_map_id_here

