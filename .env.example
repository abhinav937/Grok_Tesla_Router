# xAI Grok API key (server-only, never expose to client)
XAI_API_KEY=xai-...

# Google Maps JavaScript API key (browser-visible — restrict to your domain + Maps JS API + Places API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...

# Google Maps server API key (server-only — restrict to Directions API only)
GOOGLE_MAPS_SERVER_API_KEY=AIza...
